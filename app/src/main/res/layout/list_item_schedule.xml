<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardElevation="2dp"
    app:cardUseCompatPadding="true"
    app:cardCornerRadius="8dp"
    android:layout_marginStart="8dp"
    android:layout_marginEnd="8dp"
    android:layout_marginTop="4dp"
    android:layout_marginBottom="4dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <TextView
            android:id="@+id/tv_schedule_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            tools:text="10:00 AM" />

        <ImageView
            android:id="@+id/iv_image_indicator"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_image_placeholder"
            app:layout_constraintTop_toTopOf="@id/tv_schedule_time"
            app:layout_constraintBottom_toBottomOf="@id/tv_schedule_time"
            app:layout_constraintEnd_toEndOf="parent"
            android:visibility="gone"
            tools:visibility="visible"
            android:contentDescription="Image attached" />

        <ImageView
            android:id="@+id/iv_attended_indicator"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_attended_placeholder"
            app:layout_constraintTop_toTopOf="@id/tv_schedule_time"
            app:layout_constraintBottom_toBottomOf="@id/tv_schedule_time"
            app:layout_constraintEnd_toStartOf="@id/iv_image_indicator"
            android:layout_marginEnd="8dp"
            android:visibility="gone"
            tools:visibility="visible"
            android:contentDescription="Attended" />


        <TextView
            android:id="@+id/tv_agenda"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textSize="15sp"
            android:textAppearance="?attr/textAppearanceListItem"
            app:layout_constraintTop_toBottomOf="@id/tv_schedule_time"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            tools:text="Agenda: Meeting with team" />

        <TextView
            android:id="@+id/tv_applicant"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="14sp"
            android:textAppearance="?attr/textAppearanceListItemSecondary"
            app:layout_constraintTop_toBottomOf="@id/tv_agenda"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            tools:text="Applicant: John Doe" />

        <TextView
            android:id="@+id/tv_address"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="14sp"
            android:textAppearance="?attr/textAppearanceListItemSecondary"
            app:layout_constraintTop_toBottomOf="@id/tv_applicant"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            tools:text="Address: 123 Main St, Anytown" />

        <TextView
            android:id="@+id/tv_remarks"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="14sp"
            android:textAppearance="?attr/textAppearanceListItemSecondary"
            app:layout_constraintTop_toBottomOf="@id/tv_address"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            tools:text="Remarks: Bring presentation" />

        <ImageView
            android:id="@+id/iv_schedule_image"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_marginTop="8dp"
            android:scaleType="centerCrop"
            android:visibility="gone"
            tools:srcCompat="@tools:sample/backgrounds/scenic"
            tools:visibility="visible"
            app:layout_constraintTop_toBottomOf="@id/tv_remarks"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:contentDescription="Schedule Image" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
